# Armbian build framework checkout and its outputs (cloned by build.sh)
/armbian-build/

# Rockchip RKNN SDK files, downloaded by scripts/fetch-npu.sh (Rockchip license)
/.cache/
/userpatches/npu/librknnrt.so
/userpatches/npu/include/
/userpatches/npu/npu-test/npu_test
/userpatches/npu/npu-test/model/

# Rockchip multimedia packages and their build tree (scripts/build-multimedia.sh)
/userpatches/multimedia/

# Hailo-8 driver sources, firmware (Hailo EULA) and HailoRT package
# (scripts/fetch-hailo.sh, scripts/build-hailort.sh)
/userpatches/hailo/driver/
/userpatches/hailo/firmware/
/userpatches/hailo/*.deb
# written by HailoRT tools run on the build host
/hailort.log
