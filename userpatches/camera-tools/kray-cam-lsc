#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Kray-SoM-RKC: lens shading calibration for kray-cam-3a (vendor image).

Point the camera at an evenly lit, featureless white target that fills the
whole frame: a diffuser (several layers of tracing paper, a white plastic
lid) on the lens with even light in front, or a matte white sheet close to
the lens. Then run:

    sudo kray-cam-lsc

It runs kray-cam-3a with a linear setup (no gamma, no colour correction,
white balance gains 1.0, auto exposure at about 45%), captures frames from
the ISP main path at the sensor's full size, and computes per-colour gains
on the ISP's 17 x 17 lens shading grid, relative to the centre of the
frame: brightness up to --max-gain, colour (red and blue against green) in
full. The result goes to
/etc/kray-cam-3a/lsc-<sensor>-<width>x<height>.conf, which kray-cam-3a
loads at the next stream start for that sensor. Calibrate in the sensor's
full-size mode: kray-cam-3a maps that table onto binned and cropped modes.

Options: --frames N (default 8), --max-gain G (brightness, default 3.0), --out FILE,
--keep (keep the averaged frame as .npy next to the output), --from FILE.npy
(recompute the table from a kept frame instead of capturing).
"""
import argparse
import glob
import os
import re
import subprocess
import sys
import tempfile
import time

try:
    import numpy as np
except ImportError:
    sys.exit("kray-cam-lsc needs NumPy: sudo apt install python3-numpy")

GRID = 16  # sectors per axis; 17 x 17 grid points
MAX_TABLE_GAIN = 8191 / 1024  # the ISP's table values are 13 bits, 1024 = 1.0


def sh(*args, **kw):
    return subprocess.run(args, check=True, capture_output=True, text=True, **kw).stdout


def video_node(name):
    for d in sorted(glob.glob("/sys/class/video4linux/video*")):
        with open(d + "/name") as f:
            if f.read().strip() == name:
                return "/dev/" + os.path.basename(d)
    sys.exit("no video node named %s (camera overlay enabled?)" % name)


def sensor_and_size():
    """The sensor entity name and the ISP input size from the media graph."""
    for media in sorted(glob.glob("/dev/media*")):
        out = sh("media-ctl", "-d", media, "-p")
        if "rkisp-isp-subdev" not in out:
            continue
        sensor = re.search(r"entity \d+: (m\d+_\w_(\w+) [\w-]+)", out)
        isp = re.search(r"rkisp-isp-subdev.*?pad0: SINK.*?fmt:\w+/(\d+)x(\d+)", out, re.S)
        if sensor and isp:
            return sensor.group(2), int(isp.group(1)), int(isp.group(2))
    sys.exit("no camera found in the rkisp media graph")


def capture(node, w, h, frames):
    """Average `frames` NV12 frames from the ISP main path, after AE settled."""
    raw = tempfile.NamedTemporaryFile(suffix=".nv12", delete=False).name
    sh("v4l2-ctl", "-d", node, "--set-fmt-video=width=%d,height=%d,pixelformat=NV12" % (w, h))
    fmt = sh("v4l2-ctl", "-d", node, "--get-fmt-video")
    stride = int(re.search(r"Bytes per Line\s*:\s*(\d+)", fmt).group(1))
    sh("v4l2-ctl", "-d", node, "--stream-mmap", "--stream-skip=60",
       "--stream-count=%d" % frames, "--stream-to=" + raw)
    data = np.fromfile(raw, dtype=np.uint8)
    os.unlink(raw)
    fsize = stride * h * 3 // 2
    n = data.size // fsize
    if n < 1:
        sys.exit("captured no complete frame")
    acc = np.zeros((h * 3 // 2, stride), np.float64)
    for i in range(n):
        acc += data[i * fsize:(i + 1) * fsize].reshape(h * 3 // 2, stride)
    acc /= n
    y = acc[:h, :w]
    uv = acc[h:, :w]
    u = uv[:, 0::2].repeat(2, axis=0).repeat(2, axis=1)[:h, :w] - 128.0
    v = uv[:, 1::2].repeat(2, axis=0).repeat(2, axis=1)[:h, :w] - 128.0
    # BT.601 full range, as the ISP reports (smpte170m, full-range).
    r = y + 1.402 * v
    g = y - 0.344136 * u - 0.714136 * v
    b = y + 1.772 * u
    return np.stack([r, g, b]), n


def grid_points(size):
    """17 grid coordinates: 16 equal sectors (the ISP takes 8 sizes, mirrored)."""
    half = size // 2
    sect = [half // 8 + (1 if i < half % 8 else 0) for i in range(8)]
    sizes = sect + sect[::-1]
    pts = [0]
    for s in sizes:
        pts.append(pts[-1] + s)
    pts[-1] = size - 1
    return np.array(pts), sect


def local_fit(blocks, step, xs, ys, xsect, ysect, iters=3):
    """Shading level at each grid point: a quadratic surface fitted to the
    block means within one sector around the point, with outliers (dust,
    marks on the diffuser) dropped. A local fit follows the steep fall-off
    in the corners, where one polynomial over the whole frame does not, and
    it does not reach further than one sector past the frame edge. Returns
    the levels and the RMS residual of the points kept, relative to the
    level."""
    bh, bw = blocks.shape
    cy = (np.arange(bh) + 0.5) * step
    cx = (np.arange(bw) + 0.5) * step
    rx, ry = max(xsect), max(ysect)
    out = np.zeros((len(ys), len(xs)))
    res = []
    for j, py in enumerate(ys):
        yi = np.nonzero(np.abs(cy - py) <= ry)[0]
        for i, px in enumerate(xs):
            xi = np.nonzero(np.abs(cx - px) <= rx)[0]
            yy, xx = np.meshgrid((cy[yi] - py) / ry, (cx[xi] - px) / rx, indexing="ij")
            z = blocks[np.ix_(yi, xi)].ravel()
            x, y = xx.ravel(), yy.ravel()
            A = np.stack([np.ones_like(x), x, y, x * x, x * y, y * y], 1)
            keep = np.ones(z.size, bool)
            for _ in range(iters):
                coef, *_ = np.linalg.lstsq(A[keep], z[keep], rcond=None)
                r = z - A @ coef
                s = 1.4826 * np.median(np.abs(r[keep])) + 1e-6
                keep = np.abs(r) < 3 * s
            out[j, i] = coef[0]
            res.append(r[keep] / max(coef[0], 1e-3))
    res = np.concatenate(res)
    return out, float(np.sqrt(np.mean(res ** 2)))


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--frames", type=int, default=8)
    ap.add_argument("--max-gain", type=float, default=3.0)
    ap.add_argument("--out")
    ap.add_argument("--keep", action="store_true")
    ap.add_argument("--from", dest="src", help="recompute from a frame saved with --keep")
    a = ap.parse_args()
    if os.geteuid() != 0:
        sys.exit("run as root: sudo kray-cam-lsc")

    sensor, w, h = sensor_and_size()
    out = a.out or "/etc/kray-cam-3a/lsc-%s-%dx%d.conf" % (sensor, w, h)
    print("sensor %s, ISP input %dx%d -> %s" % (sensor, w, h, out))
    if a.src:
        rgb = np.load(a.src).astype(np.float64)
        if rgb.shape[1:] != (h, w):
            sys.exit("%s is %dx%d, the camera runs %dx%d" % (a.src, rgb.shape[2], rgb.shape[1], w, h))
        return compute(a, sensor, w, h, rgb, 0, out)

    conf = tempfile.NamedTemporaryFile("w", suffix=".conf", delete=False)
    conf.write("ae = 1\ntarget = 0.45\nawb = 0\nwb_red = 1.0\nwb_blue = 1.0\n"
               "gamma = 0\nblack_level_subtraction = 1\nlsc = 0\nccm = 0\n")
    conf.close()
    was_active = subprocess.run(["systemctl", "is-active", "--quiet", "kray-cam-3a"]).returncode == 0
    subprocess.run(["systemctl", "stop", "kray-cam-3a"])
    cam3a = subprocess.Popen(["kray-cam-3a", "-c", conf.name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        time.sleep(1)
        rgb, n = capture(video_node("rkisp_mainpath"), w, h, a.frames)
    finally:
        cam3a.terminate()
        cam3a.wait()
        os.unlink(conf.name)
        if was_active:
            subprocess.run(["systemctl", "start", "kray-cam-3a"])

    return compute(a, sensor, w, h, rgb, n, out)


def compute(a, sensor, w, h, rgb, n, out):
    xs, xsect = grid_points(w)
    ys, ysect = grid_points(h)
    win = max(8, min(w, h) // 64)
    centre = [rgb[c, h // 2 - win:h // 2 + win, w // 2 - win:w // 2 + win].mean() for c in range(3)]
    if min(centre) < 40 or max(centre) > 235:
        sys.exit("centre level %s is too dark or saturated; adjust the light" % [round(c) for c in centre])
    # Shading map per colour on a coarse grid (8 x 8 pixel blocks), fitted
    # locally around each of the 17 x 17 grid points.
    step = 8
    hh, ww = (h // step) * step, (w // step) * step
    levels, report = [], []
    for c in range(3):
        blocks = rgb[c, :hh, :ww].reshape(hh // step, step, ww // step, step).mean(axis=(1, 3))
        lv, rms = local_fit(blocks, step, xs, ys, xsect, ysect)
        levels.append(np.maximum(lv / lv[GRID // 2, GRID // 2], 1.0 / 16))
        report.append("%s rms %.3f" % ("RGB"[c], rms))
    # Brightness (green) is corrected up to --max-gain, as more brings up the
    # noise too much. Colour is corrected in full: red and blue get the green
    # gain times their shading relative to green (up to the ISP's 8x), so the
    # corners stay neutral even where they stay darker.
    g_gain = np.clip(1.0 / levels[1], 1.0, a.max_gain)
    gains = [np.clip(g_gain * levels[1] / levels[c], 0.5, MAX_TABLE_GAIN) if c != 1 else g_gain
             for c in range(3)]
    print("%d frames; centre R/G/B %s; corner level vs centre R/G/B %s" %
          (n, [round(c) for c in centre], [round(float(l[0, 0]), 2) for l in levels]))
    print("fit: " + ", ".join(report))
    if g_gain.max() >= a.max_gain - 0.005:
        print("note: brightness gains hit --max-gain %.1f (colour is corrected in full)" % a.max_gain)

    # Bayer channel order of the ISP tables: R, Gr, Gb, B; 1024 = gain 1.0.
    tables = [gains[0], gains[1], gains[1], gains[2]]
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as f:
        f.write("# kray-cam-lsc %s: %s %dx%d, %d frames, max gain %.1f\n" %
                (time.strftime("%Y-%m-%d"), sensor, w, h, n, a.max_gain))
        f.write("size = %d %d\n" % (w, h))
        f.write("x_sect = %s\n" % " ".join(map(str, xsect)))
        f.write("y_sect = %s\n" % " ".join(map(str, ysect)))
        for name, t in zip(("r", "gr", "gb", "b"), tables):
            vals = np.clip(np.rint(t * 1024), 512, 8191).astype(int)
            for row in range(GRID + 1):
                f.write("%s%d = %s\n" % (name, row, " ".join(map(str, vals[row]))))
    if a.keep:
        np.save(os.path.splitext(out)[0] + ".npy", rgb.astype(np.float32))
    print("written %s; restart kray-cam-3a (or the stream) to use it" % out)


if __name__ == "__main__":
    main()
