[Unit]
Description=Rockchip camera 3A (auto exposure, white balance) for rkisp
Documentation=file:///usr/share/doc/camera-engine-rkaiq/README
# Only with the IMX477 overlay: there is no tuning file for other sensors yet
ConditionPathExists=/proc/device-tree/i2c@fe5a0000/imx477@1a
After=systemd-udev-settle.service

[Service]
ExecStart=/usr/bin/rkaiq_3A_server --silent
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
