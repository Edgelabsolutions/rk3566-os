config VIDEO_ARDUCAM_64MP
	tristate "Arducam 64 MP camera support"
	depends on I2C && VIDEO_DEV
	depends on MEDIA_CAMERA_SUPPORT
	select MEDIA_CONTROLLER
	select VIDEO_V4L2_SUBDEV_API
	select V4L2_FWNODE
	help
	  Raspberry Pi's driver for the Arducam 64 MP camera (2 MIPI CSI-2
	  lanes), with the bus configuration and frame interval calls the
	  Rockchip CSI-2 D-PHY and ISP drivers need.

	  The module is called arducam_64mp.

