config VIDEO_RPI_IMX335
	tristate "Sony IMX335 sensor support (Raspberry Pi driver)"
	depends on I2C && VIDEO_DEV
	depends on MEDIA_CAMERA_SUPPORT
	select MEDIA_CONTROLLER
	select VIDEO_V4L2_SUBDEV_API
	select V4L2_FWNODE
	select REGMAP_I2C
	help
	  Raspberry Pi's driver for the Sony IMX335 (2 or 4 MIPI CSI-2
	  lanes, 24 MHz input clock), backported to Linux 6.1, with the bus
	  configuration and frame interval calls the Rockchip CSI-2 D-PHY
	  and ISP drivers need.

	  The module is called rpi_imx335.

