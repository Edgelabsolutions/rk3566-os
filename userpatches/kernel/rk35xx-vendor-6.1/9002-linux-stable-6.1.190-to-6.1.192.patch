-	end = bh_cpos << vol->cluster_size_bits;
-	do {
-		page = pages[u];
-		bh = head = page_buffers(page);
-		do {
-			if (u == nr_pages &&
-					((s64)page->index << PAGE_SHIFT) +
-					bh_offset(bh) >= end)
